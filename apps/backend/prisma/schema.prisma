// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Creator {
  id              String   @id @default(uuid())
  walletAddress   String   @unique @db.VarChar(42)
  displayName     String   @db.VarChar(100)
  bio             String?
  avatarCid       String?  @db.VarChar(100)
  organizationId  String?
  onChainConfirmed Boolean @default(false)
  registrationTxHash String? @db.VarChar(66)
  createdAt       DateTime @default(now())

  @@map("creators")
  @@index([walletAddress])

  assets Asset[]
  reviewsGiven Review[]
}


model IndexerState {
  id            String   @id @default(uuid())
  indexerName   String   @unique @db.VarChar(100)
  lastBlock     BigInt
  updatedAt     DateTime @updatedAt

  @@map("indexer_state")
}


model Asset {
  id                String   @id @default(uuid())
  creatorId         String
  creator           Creator  @relation(fields: [creatorId], references: [id])
  contentHash       String   @unique @db.VarChar(66)
  ipfsCid           String   @db.VarChar(100)
  metadataCid       String   @db.VarChar(100)
  title             String   @db.VarChar(200)
  description       String?
  aiGeneratedFlag   Boolean  @default(false)
  registeredAt      DateTime?
  txHash            String?  @db.VarChar(66)
  onChainConfirmed  Boolean  @default(false)
  certificateCid    String?  @db.VarChar(100)
  proofId           String?  @unique @db.VarChar(20)

  @@map("assets")
  @@index([creatorId])

  reviews Review[]
}


model Review {
  id             String   @id @default(uuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])
  reviewerId     String
  reviewer       Creator  @relation(fields: [reviewerId], references: [id])
  rating         Int
  comment        String?
  txHash         String   @db.VarChar(66)
  createdAt      DateTime @default(now())

  @@map("reviews")
  @@unique([assetId, reviewerId])
  @@index([assetId])
}