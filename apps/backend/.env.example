DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/originchain?schema=public"

# Session auth (SIWE + JWT)
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
SESSION_TOKEN_EXPIRY=7d
APP_DOMAIN=localhost:3000
FRONTEND_URL=http://localhost:3000

PINATA_JWT=<your Pinata JWT token>
PINATA_GATEWAY_URL=<your Pinata dedicated gateway domain, e.g. your-gateway.mypinata.cloud>