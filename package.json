{
    "name": "originchain",
    "private": true,
    "version": "0.1.0",
    "description": "Decentralized creator identity & proof-of-origin platform on Arbitrum",
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=20.0.0"
    },
    "pnpm": {
        "overrides": {
            "dotenv": "16.4.5",
            "hono": "^4.12.34",
            "postcss": "^8.5.23",
            "ws": "^8.21.0",
            "axios": "^1.18.0",
            "nanoid": "^3.3.17"
        }
    },
    "scripts": {
        "dev:frontend": "pnpm --filter frontend dev",
        "dev:backend": "pnpm --filter backend dev",
        "build": "pnpm -r build",
        "lint": "pnpm -r lint",
        "format": "prettier --write ."
    }
}